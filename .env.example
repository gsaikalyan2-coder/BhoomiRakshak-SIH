# ---- filled in Phase 1 ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lade
POSTGRES_USER=lade
POSTGRES_PASSWORD=ENTER_YOUR_VALUE_HERE
DATABASE_URL=postgresql+psycopg://lade:ENTER_YOUR_VALUE_HERE@localhost:5432/lade

# ---- filled in Phase 2 (auth) ----
JWT_SECRET_KEY=ENTER_YOUR_VALUE_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# ---- filled in Phase 4 (ML serving) ----
MODEL_REGISTRY_PATH=./ml/experiments/registry
ACTIVE_MODEL_VERSION=ENTER_YOUR_VALUE_HERE
SHAP_BACKGROUND_SAMPLE=200

# ---- filled in Phase 5 (recommendations) ----
FLAN_T5_MODEL_NAME=google/flan-t5-base
HF_HOME=./.cache/hf

# ---- filled in Phase 6 (alerts) ----
ALERT_WEBHOOK_URL=ENTER_YOUR_VALUE_HERE
SMTP_HOST=ENTER_YOUR_VALUE_HERE
SMTP_PORT=587
SMTP_USER=ENTER_YOUR_VALUE_HERE
SMTP_PASSWORD=ENTER_YOUR_VALUE_HERE
ALERT_RISK_THRESHOLD=0.75

# ---- frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
